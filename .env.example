# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/mfa_platform
# Comma-separated browser origins allowed by CORS / Socket.IO
CLIENT_ORIGINS=http://localhost:5173,http://localhost:4000

# --- Secrets (REQUIRED in production; dev fallbacks are used when empty) ---
# Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# 32 bytes as 64 hex chars: AES-256-GCM key for HOTP/TOTP secrets at rest
SECRETS_ENCRYPTION_KEY=
# Pepper for HMAC-SHA-256 hashing of email OTP codes
OTP_HMAC_KEY=
# true behind HTTPS (production); false for http://localhost
COOKIE_SECURE=false

# --- Email (OOB) provider: ethereal | brevo | gmail | mailtrap | local ---
# ethereal: no signup, test account auto-created, preview URL shown in the UI.
# local: in-process SMTP sink on 127.0.0.1 (STARTTLS) for offline/firewalled machines.
MAIL_PROVIDER=ethereal
MAIL_FROM="MFA Benchmark Platform <no-reply@mfa-platform.test>"
# Fall back to the local sink if Ethereal is unreachable (recorded in results)
MAIL_FALLBACK_LOCAL=true
LOCAL_SMTP_PORT=2526
# Brevo free tier (real delivery): see README "Free Brevo SMTP credentials"
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
# 587 (default) or 2525 (STARTTLS), 465 (implicit TLS). Use 2525 where 587/465 are blocked (e.g. some hosts' free tiers)
BREVO_SMTP_PORT=587
BREVO_MAX_BENCH_EMAILS=50
# Gmail with an app password (optional)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Mailtrap sandbox (optional)
MAILTRAP_USER=
MAILTRAP_PASS=
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525

# --- WebAuthn relying party ---
# Must match the origin the browser shows. Dev (Vite): http://localhost:5173 ; built client served by API: http://localhost:4000
# On Render these default to RENDER_EXTERNAL_HOSTNAME / RENDER_EXTERNAL_URL automatically
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=MFA Comparative Platform
WEBAUTHN_ORIGIN=http://localhost:5173
# Optional: Chrome/Chromium for the benchmark's virtual authenticator (else Playwright's or system Chrome)
CHROMIUM_PATH=

# --- Benchmark ---
BENCHMARK_CONCURRENCY=1
BENCHMARK_MAX_ITERATIONS=10000
# Show the test-mailbox link / local inbox in the UI in production (demo deployments only)
MAIL_TEST_INBOX_IN_UI=false
# Express trust proxy: 1 behind one reverse proxy (Render, Nginx); loopback for local
TRUST_PROXY=loopback
# Serve client/dist from the API (single-port mode)
SERVE_CLIENT=false
LOG_LEVEL=info

# --- Seed accounts (dev defaults: admin/AdminPass#2026, demo/DemoPass#2026) ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@mfa-platform.test
SEED_ADMIN_PASSWORD=
SEED_DEMO_USERNAME=demo
SEED_DEMO_EMAIL=demo@mfa-platform.test
SEED_DEMO_PASSWORD=
